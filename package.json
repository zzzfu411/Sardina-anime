{
  "name": "sardina-anime",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Sardina anime：本地动漫播放器",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "start": "node dist/engine/cli.js --open",
    "desktop": "node --import tsx scripts/desktop-dev.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages scripts tests/*.ts tests/e2e *.ts *.json docs/*.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "probe": "node --import tsx scripts/probe.ts",
    "package:mac": "node --import tsx scripts/package.ts --mac",
    "package:win": "node --import tsx scripts/package.ts --win",
    "verify:desktop": "node --import tsx scripts/verify-desktop.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.0",
    "hls.js": "^1.6.13",
    "https-proxy-agent": "^7.0.6",
    "ipaddr.js": "^2.2.0",
    "json5": "^2.2.3",
    "lucide-react": "^0.468.0",
    "m3u8-parser": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tough-cookie": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "prettier": "^3.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
